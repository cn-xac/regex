{
  "name": "@x-ac/regex-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for regex: framework-agnostic regex workbench engine (safe compiler, DOM-free railroad/AST layout, SVG + Canvas painters, bilingual i18n) + Vue 3 and React 18/19 adapters + Vite playground. pnpm workspace root.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm build && pnpm --filter playground dev",
    "dev:play": "pnpm --filter playground dev",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "verify:dist": "node tools/verify-dist.mjs",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
